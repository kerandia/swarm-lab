{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "nebius": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Nebius Token Factory",
      "options": {
        "baseURL": "https://api.studio.nebius.ai/v1",
        "apiKey": "{env:NEBIUS_API_KEY}"
      },
      "models": {
        "moonshotai/Kimi-K3": {
          "name": "Kimi K3",
          "limit": {
            "context": 1000000,
            "output": 32000
          }
        }
      }
    }
  },
  "model": "nebius/moonshotai/Kimi-K3",
  "share": "disabled",
  "autoupdate": false,
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "deny",
    "websearch": "deny"
  },
  "skills": {
    "paths": [
      "/home/sandbox/.config/opencode/skills"
    ]
  }
}
