# Copy to .env and fill in. .env overrides the devlab template's placeholder env vars.

# Nebius Token Factory (OpenAI-compatible).
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1/
# Model for any agent whose design entry has no "model" (designs/v0.json sets them per agent).
SWARM_MODEL=MiniMaxAI/MiniMax-M3

# MASS-lite optimizer and judge (default: SWARM_MODEL).
# OPTIMIZER_MODEL=
# JUDGE_MODEL=

# SubQ Snap key for the critic's verify_claims tool (optional).
# SUBQ_API_KEY=

# Web interface (app.py). An empty access code makes the API open to anyone.
SWARM_UI_CODE=
SWARM_UI_TOKEN_BUDGET=300000
SWARM_UI_DAILY_RUNS=20

# Page builder (builder.py).
# Public address that serves swarm/public/ (for example a Nebius tunnel service).
SWARM_PUBLIC_BASE=
SWARM_UI_DAILY_BUILDS=3
SWARM_BUILD_MINUTES=60
# SWARM_BUILDER_IMAGE=swarm-builder:1
# SWARM_BUILDER_PROVIDER=swarm-builder-nebius
